{
  // Configuracion del Worker de Cloudflare para el panel AviTech.
  // Publica el resultado de "npm run build" (carpeta dist/) y ademas atiende la
  // API interna del Auditor SEO en /api/seo/* (worker/index.js).
  "name": "aviech",
  "main": "worker/index.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Valores publicos (los mismos que van en .env.production): el Worker los usa
    // para comprobar la sesion del usuario contra Supabase.
    "SUPABASE_URL": "https://ktvyhtbmokmrzeuibznv.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_UFmcdmDc2j75X8vBcYhWww_G6DGneAl",
    // Dominio público del sitio: se usa en los avisos internos de solicitudes.
    "SITIO_URL": "https://aviech.avismael-eg.workers.dev",
    // Modelo de Workers AI. Overrides opcionales por función:
    // IA_MODELO_ASISTENTE, IA_MODELO_SOLICITUDES e IA_MODELO_TALENTO.
    "IA_MODELO": "@cf/google/gemma-4-26b-a4b-it"
  },
  // Asistente de IA: Workers AI incluido en el plan gratis (10,000 neuronas/dia).
  // No usa claves externas ni modelos de pago.
  "ai": {
    "binding": "AI"
  }
}
