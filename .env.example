# Copia este archivo como .env y completa los valores.
# Los encuentras en: Supabase → tu proyecto → Project Settings → API.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anonima

# Sitio comercial (opcionales y públicos). Si quedan vacíos, el canal no se muestra.
# WhatsApp con código de país y solo dígitos, por ejemplo: 18095551234
VITE_WHATSAPP=
VITE_CONTACTO_CORREO=
VITE_CONTACTO_TELEFONO=
